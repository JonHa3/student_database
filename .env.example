# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings > API). Never commit .env.local — it's already
# in .gitignore.

# Public — safe to expose in the browser. Actual data access is enforced by
# Postgres Row Level Security policies, not by keeping these secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server-only, bypasses Row Level Security. Used solely by the Team
# page to list authenticated users. Never expose this to the browser or
# commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
